# Neon Postgres connection string (Vercel marketplace -> Neon)
DATABASE_URL=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend for magic-link sign-in + turn notification emails (https://resend.com)
AUTH_RESEND_KEY=
EMAIL_FROM="Risk II Online <login@example.com>"

# Public URL of the deployment (used in notification links)
APP_URL=

# Pusher Channels — realtime "state changed" signals (https://pusher.com)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:ops@example.com"

# Protects /api/cron/deadlines (Vercel sends it automatically)
CRON_SECRET=
